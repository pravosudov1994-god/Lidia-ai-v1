# Never commit real secrets.

# Optional: used by the legacy/general text chat path.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.4-mini

# Free Cloudflare Workers AI path for image analysis, image generation
# and presentation planning. Create a Workers AI API token in Cloudflare.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_AI_TOKEN=your_workers_ai_api_token
